# Application settings
# NASベースパスを設定してください
# macOS例: /Volumes/disk1/DESIGN
# Windows例（マップ済みドライブ）: Z:\DESIGN
# Windows例（UNCパス）: \\HIYOSHI1\disk1\DESIGN
NAS_BASE_PATH=/Volumes/disk1/DESIGN

# サーバーを別ポートで起動したい場合は PORT を指定します
# PORT=3000

# LINE Messaging API (LINE Developers コンソールで発行)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic API (LINEメッセージの構造化抽出用)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_EXTRACTION_QUIET_MINUTES=15

# 公式LINE入口フォーム(/inquiry/*)とお客様の公式LINEトークの紐づけ(2026-09-14・どちらも任意)
# LINE_OA_BASIC_ID … 公式アカウントのベーシックID(公式LINEマネージャー > 設定 > アカウント設定。例 @abc1234)。
#                    送信完了画面・受付控えメールに「受付番号入りの本文が入力済みでトークが開く」リンクを出す
# LINE_LIFF_ID     … LIFF ID(LINE Developers > LINE Loginチャネル > LIFF。エンドポイントURLは <公開URL>/inquiry)。
#                    LINEアプリ内で開いたとき、送信と同時にトークへ受付番号を自動投稿する
LINE_OA_BASIC_ID=
LINE_LIFF_ID=
