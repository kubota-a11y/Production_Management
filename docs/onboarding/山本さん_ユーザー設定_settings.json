{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*)",
      "Read(**/パスワード*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(*Production_Management_v2*)"
    ]
  }
}
